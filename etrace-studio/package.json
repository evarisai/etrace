{
  "name": "etrace-studio",
  "version": "0.1.0",
  "description": "Local trace inspection UI for etrace - run with npx etrace-studio",
  "bin": {
    "etrace-studio": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    ".output/server/",
    ".output/public/",
    "README.md"
  ],
  "keywords": [
    "etrace",
    "tracing",
    "observability",
    "ai",
    "llm",
    "agents",
    "studio",
    "otlp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evarisai/etrace",
    "directory": "etrace-studio"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint && prettier --check \"**/*.{ts,tsx,js,jsx}\" && vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-router-ssr-query": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/router-plugin": "^1.166.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.0.0",
    "jsdom": "^27.4.0",
    "lucide-react": "^1.16.0",
    "nitro": "3.0.260522-beta",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  }
}
