# Z.AI exposes OpenAI-compatible APIs.
ZAI_API_KEY="your_zai_api_key"
OPENAI_BASE_URL="https://api.z.ai/api/paas/v4/"
OPENAI_MODEL="glm-5.1"

# Tavily is used by the research tool to discover URLs.
TAVILY_API_KEY="your_tavily_api_key"

# etrace Studio OTLP HTTP receiver.
# Start etrace Studio locally and point this at its OTLP endpoint.
ETRACE_STUDIO_OTLP_ENDPOINT="http://localhost:3001/v1/traces"
