{
  "name": "etrace",
  "version": "0.1.0",
  "description": "AI agent tracing library — zero-dep core, composable pipeline, auto-instruments LLM calls",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "import": "./dist/pricing.js"
    },
    "./exporter": {
      "types": "./dist/exporter.d.ts",
      "import": "./dist/exporter.js"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "import": "./dist/processor.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js"
    },
    "./evaris": {
      "types": "./dist/evaris/index.d.ts",
      "import": "./dist/evaris/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "check": "tsc --noEmit && eslint src/ tests/ && prettier --check 'src/**/*.ts' 'tests/**/*.ts' && vitest run",
    "build": "tsc"
  },
  "keywords": [
    "tracing",
    "observability",
    "ai",
    "llm",
    "agents"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/resources": "^2.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@types/node": "^22.19.19",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.2.1"
  }
}
